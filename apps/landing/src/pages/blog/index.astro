---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/header';
import { Footer } from '../../components/footer';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Blog — zivodoc',
  description: 'Articles on developer documentation quality, docs QA automation, and keeping technical content accurate.',
  url: 'https://zivodoc.com/blog',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://zivodoc.com' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://zivodoc.com/blog' },
    ],
  },
};
---

<Layout
  title="Blog — zivodoc"
  description="Articles on developer documentation quality, docs QA automation, and keeping technical content accurate."
  jsonLd={jsonLd}
>
  <Header client:load />
  <main>
    <section class="bg-surface">
      <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-14 pt-24 sm:pt-32 lg:pt-40 pb-16 sm:pb-20">
        <p class="font-label text-[12px] font-bold uppercase tracking-[0.08em] text-ink-muted mb-6">
          Blog
        </p>
        <h1 class="text-[36px] sm:text-[56px] lg:text-[72px] font-semibold leading-[1.0] tracking-[-0.04em] max-w-[800px]">
          Thoughts on <span class="text-ink-secondary">docs quality.</span>
        </h1>
      </div>
    </section>

    <section class="bg-surface border-t border-line">
      <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-14 py-8 sm:py-12">
        <div class="flex flex-col divide-y divide-line">
          {posts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });

            return (
              <a
                href={`/blog/${post.id}`}
                class="group py-8 sm:py-10 lg:py-14 grid lg:grid-cols-12 gap-3 lg:gap-10 items-start"
              >
                <div class="lg:col-span-3">
                  <time
                    datetime={post.data.date.toISOString()}
                    class="font-label text-[13px] text-ink-muted"
                  >
                    {formattedDate}
                  </time>
                </div>
                <div class="lg:col-span-6">
                  <h2 class="text-[20px] sm:text-[24px] lg:text-[28px] font-semibold leading-[1.2] tracking-[-0.02em] text-ink group-hover:text-ink-secondary transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="mt-3 text-[14px] sm:text-[15px] leading-[1.6] text-ink-secondary">
                    {post.data.description}
                  </p>
                </div>
                <div class="lg:col-span-3 lg:text-right">
                  <div class="flex lg:flex-col lg:items-end gap-3">
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span class="font-label text-[10px] uppercase tracking-[0.06em] text-ink-dim">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
