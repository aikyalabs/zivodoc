---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/header';
import { Footer } from '../components/footer';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Join the Waitlist — zivodoc',
  description: 'Sign up for early access to zivodoc. Automated QA for developer documentation.',
  url: 'https://zivodoc.com/waitlist',
};
---

<Layout title="Join the Waitlist — zivodoc" description="Sign up for early access to zivodoc. Automated QA for developer documentation." jsonLd={jsonLd}>
  <Header client:load />
  <main>
    <section class="bg-surface">
      <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-14 pt-24 sm:pt-32 lg:pt-40 pb-8 sm:pb-12">
        <div class="text-center max-w-[600px] mx-auto">
          <p class="font-label text-[12px] font-bold uppercase tracking-[0.08em] text-ink-muted mb-6">
            Early Access
          </p>
          <h1 class="text-[36px] sm:text-[48px] lg:text-[56px] font-semibold leading-[1.04] tracking-[-0.04em]">
            Get early access <span class="text-ink-secondary">to zivodoc</span>
          </h1>
          <p class="mt-6 text-[16px] sm:text-[17px] leading-[1.6] text-ink-secondary">
            Be the first to scan your docs. Free and unlimited while we're in beta.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-surface pb-20 sm:pb-32">
      <div class="max-w-[640px] mx-auto px-5 sm:px-8">
        <iframe
          data-tally-src="https://tally.so/embed/81pzNr?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
          loading="lazy"
          width="100%"
          height="400"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="Join the zivodoc waitlist"
          style="border: none;"
        ></iframe>
        <script is:inline src="https://tally.so/widgets/embed.js"></script>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
