---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/header';
import { HeroSplit } from '../components/hero-split';

import { Problem } from '../components/problem';
import { Solution } from '../components/solution';
import { DashboardSection } from '../components/dashboard-section';
import { Stats } from '../components/stats';
import { Features } from '../components/features';
import { ScanVisual } from '../components/scan-visual';
import { TechMarquee } from '../components/tech-marquee';
import { CTA } from '../components/cta';
import { Footer } from '../components/footer';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'zivodoc',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  description: 'Automated QA for developer documentation. Scans for broken code examples, stale API references, and dead links — surfaces them in CI and your dashboard.',
  url: 'https://zivodoc.com',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free tier — no credit card required',
  },
  featureList: [
    'JavaScript runtime execution in WASM sandbox',
    'JS / TS / JSON / YAML syntax validation',
    'API reference validation against OpenAPI 3.0, 3.1, and Swagger 2.0',
    'Dead link, redirect, and anchor checking',
    'Secret leak detection',
    'GitHub App: PR checks and inline comments',
    'GitHub Action and CLI for CI integration',
    'Scheduled scans (daily / weekly / on-push)',
  ],
};
---

<Layout title="zivodoc — Automated QA for Developer Documentation" jsonLd={jsonLd}>
  <Header client:load />
  <main>
    <HeroSplit client:load />
    <Problem client:visible />
    <Solution client:visible />
    <DashboardSection client:visible />
    <Stats client:visible />
    <Features client:visible />
    <ScanVisual client:visible />
    <TechMarquee client:visible />
    <CTA client:visible />
  </main>
  <Footer />
</Layout>
